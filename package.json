{
  "name": "woodpecker-ci-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Woodpecker CI. Lets AI assistants like Claude inspect pipelines, workflows, steps and decoded build logs. Zero dependencies, single-file, stdio transport.",
