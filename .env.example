# Copy to .env (or pass these as MCP server env vars) and fill in your values.
# Base URL of your Woodpecker CI instance, no trailing slash.
WOODPECKER_URL=https://your-woodpecker.example.com
# Personal Access Token: Woodpecker UI -> User settings -> CLI and API -> Personal Access Token
WOODPECKER_TOKEN=your-woodpecker-personal-access-token
